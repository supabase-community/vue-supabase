{
  "compilerOptions": {
    "target": "es2020",
    "strictNullChecks": true,
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "rootDir": "src",
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2020"]
  },
  "include": [
    "src/index.ts",
    "src/state.ts",
    "src/types.ts",
    "src/useSupabaseClient.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
