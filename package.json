{
  "name": "@supabase-community/vue",
  "version": "3.0.0",
  "description": "A minimal Vue 3 integration layer for Supabase.",
  "keywords": [
    "vue",
    "vue3",
    "supabase",
    "@supabase-community/vue"
  ],
  "author": "Supabase Community",
  "license": "MIT",
  "homepage": "https://github.com/supabase-community/vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supabase-community/vue.git"
  },
  "bugs": {
    "url": "https://github.com/supabase-community/vue/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir dist --declaration --declarationMap false",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.52.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.4",
    "vue-eslint-parser": "^9.0.0"
  }
}
